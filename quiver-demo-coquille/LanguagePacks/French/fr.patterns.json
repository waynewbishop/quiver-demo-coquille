  "entries": [
    {
      "fix": "ça va",
      "kind": "lookAlike",
      "match": "cava",
      "note": "cava is a past form of caver, “to dig,” as in il cava un trou.",
      "unlessAfter": [
        "il",
        "elle",
        "on",
        "qui"
      ],
      "unlessBefore": [
        "un",
        "une",
        "le",
        "la",
        "les",
        "l'",
        "des",
        "du"
      ]
    },
    {
      "fix": "ça va",
      "kind": "lookAlike",
      "match": "sava",
      "note": "sava isn't a French word; it sounds like two words run together."
    },
    {
      "fix": "ça va",
      "kind": "lookAlike",
      "match": "sa va",
      "note": "sa means his or her, so it comes before a noun, never before a verb like va."
    },
    {
      "fix": "ça va",
      "kind": "lookAlike",
      "match": "ça vas",
      "note": "ça takes the il form of the verb, and vas is the tu form."
    },
    {
      "fix": "@avoir $avoirNoun",
      "kind": "wordChoice",
      "match": "@être $avoirNoun",
      "note": "French says avoir for hunger, thirst, fear and sleepiness."
    },
    {
      "fix": "@poser une question",
      "kind": "wordChoice",
      "match": "@demander une question",
      "note": "French asks a question with poser, not demander."
    },
    {
      "fix": "@prendre une décision",
      "kind": "wordChoice",
      "match": "@faire une décision",
      "note": "French takes a decision, with prendre, rather than making one."
    },
    {
      "fix": "@suivre un cours",
      "kind": "wordChoice",
      "match": "@prendre une classe",
      "note": "A classe is a group of students or a room; taking a course is suivre un cours."
    },
    {
      "fix": "@parler au téléphone",
      "kind": "preposition",
      "match": "@parler sur le téléphone",
      "note": "On the phone is au téléphone; sur le téléphone means on top of it."
    },
    {
